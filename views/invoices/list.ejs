<%- include('../layout', { body: `
<div class="flex justify-between items-center mb-8">
  <h1 class="text-3xl font-bold text-gray-900">Your Invoices</h1>
  <a href="/invoices/new" class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition font-medium">
    + New Invoice
  </a>
</div>

${invoices.length === 0 ? `
<div class="text-center py-16 bg-white rounded-xl shadow-sm">
  <div class="text-6xl mb-4">📄</div>
  <h2 class="text-xl font-semibold text-gray-700 mb-2">No invoices yet</h2>
  <p class="text-gray-500 mb-6">Create your first invoice to get started</p>
  <a href="/invoices/new" class="bg-primary text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition font-medium">
    Create Invoice
  </a>
</div>
` : `
<div class="bg-white rounded-xl shadow-sm overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Invoice</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Client</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Due Date</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      ${invoices.map(inv => `
      <tr class="hover:bg-gray-50">
        <td class="px-6 py-4 whitespace-nowrap">
          <a href="/invoices/${inv.id}" class="text-primary font-medium hover:underline">${inv.invoice_number}</a>
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-gray-700">${inv.client_name}</td>
        <td class="px-6 py-4 whitespace-nowrap font-semibold">€${parseFloat(inv.total).toFixed(2)}</td>
        <td class="px-6 py-4 whitespace-nowrap text-gray-500">${inv.due_date ? new Date(inv.due_date).toLocaleDateString() : '-'}</td>
        <td class="px-6 py-4 whitespace-nowrap">
          <span class="px-2 py-1 text-xs font-medium rounded-full ${inv.status === 'paid' ? 'bg-green-100 text-green-800' : inv.status === 'sent' ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-800'}">
            ${inv.status}
          </span>
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
          <a href="/pdf/${inv.id}" class="text-gray-600 hover:text-primary mr-3">PDF</a>
          <a href="/invoices/${inv.id}/edit" class="text-gray-600 hover:text-primary">Edit</a>
        </td>
      </tr>
      `).join('')}
    </tbody>
  </table>
</div>
`}
`, title: 'Invoices', user: user }) %>
