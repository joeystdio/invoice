<%- include('../layout', { body: `
<div class="mb-6">
  <a href="/invoices" class="text-gray-500 hover:text-gray-700">← Back to invoices</a>
</div>

<div class="bg-white rounded-xl shadow-sm p-8">
  <div class="flex justify-between items-start mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">${invoice.invoice_number}</h1>
      <span class="inline-block mt-2 px-3 py-1 text-sm font-medium rounded-full ${invoice.status === 'paid' ? 'bg-green-100 text-green-800' : invoice.status === 'sent' ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-800'}">
        ${invoice.status}
      </span>
    </div>
    <div class="flex gap-3">
      <a href="/pdf/${invoice.id}" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-200 transition font-medium">
        📥 Download PDF
      </a>
      <a href="/invoices/${invoice.id}/edit" class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition font-medium">
        Edit
      </a>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-8 mb-8">
    <div>
      <h3 class="text-sm font-medium text-gray-500 mb-1">Bill To</h3>
      <p class="font-semibold text-gray-900">${invoice.client_name}</p>
      ${invoice.client_email ? `<p class="text-gray-600">${invoice.client_email}</p>` : ''}
      ${invoice.client_address ? `<p class="text-gray-600 whitespace-pre-line">${invoice.client_address}</p>` : ''}
    </div>
    <div class="text-right">
      <p class="text-gray-500">Date: <span class="text-gray-900">${new Date(invoice.created_at).toLocaleDateString()}</span></p>
      ${invoice.due_date ? `<p class="text-gray-500">Due: <span class="text-gray-900">${new Date(invoice.due_date).toLocaleDateString()}</span></p>` : ''}
    </div>
  </div>

  <table class="w-full mb-8">
    <thead>
      <tr class="border-b-2 border-gray-200">
        <th class="text-left py-3 text-gray-500 font-medium">Description</th>
        <th class="text-right py-3 text-gray-500 font-medium w-24">Qty</th>
        <th class="text-right py-3 text-gray-500 font-medium w-32">Rate</th>
        <th class="text-right py-3 text-gray-500 font-medium w-32">Amount</th>
      </tr>
    </thead>
    <tbody>
      ${(typeof invoice.items === 'string' ? JSON.parse(invoice.items) : invoice.items).map(item => `
      <tr class="border-b border-gray-100">
        <td class="py-3 text-gray-900">${item.description}</td>
        <td class="py-3 text-right text-gray-700">${item.qty}</td>
        <td class="py-3 text-right text-gray-700">€${parseFloat(item.rate).toFixed(2)}</td>
        <td class="py-3 text-right text-gray-900 font-medium">€${(parseFloat(item.qty) * parseFloat(item.rate)).toFixed(2)}</td>
      </tr>
      `).join('')}
    </tbody>
  </table>

  <div class="flex justify-end">
    <div class="w-64">
      <div class="flex justify-between py-2 text-gray-600">
        <span>Subtotal</span>
        <span>€${parseFloat(invoice.subtotal).toFixed(2)}</span>
      </div>
      ${parseFloat(invoice.tax_rate) > 0 ? `
      <div class="flex justify-between py-2 text-gray-600">
        <span>Tax (${invoice.tax_rate}%)</span>
        <span>€${parseFloat(invoice.tax_amount).toFixed(2)}</span>
      </div>
      ` : ''}
      <div class="flex justify-between py-3 border-t-2 border-gray-200 text-xl font-bold">
        <span>Total</span>
        <span>€${parseFloat(invoice.total).toFixed(2)}</span>
      </div>
    </div>
  </div>

  ${invoice.notes ? `
  <div class="mt-8 pt-8 border-t border-gray-200">
    <h3 class="text-sm font-medium text-gray-500 mb-2">Notes</h3>
    <p class="text-gray-700 whitespace-pre-line">${invoice.notes}</p>
  </div>
  ` : ''}
</div>
`, title: invoice.invoice_number, user: user }) %>
